# 双实例上游(A4):默认轮询分发;max_fails/fail_timeout 让挂掉的实例被临时摘除。
# 注意主机名 backend-1/backend-2 必须与 docker-compose.yml 的服务名一致 ——
# envsubst 只替换真实存在的环境变量,这里的字面量不会被误替换。
upstream ${BACKEND_UPSTREAM} {
    server backend-1:9001 max_fails=2 fail_timeout=10s;
    server backend-2:9001 max_fails=2 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80;

    # 静态资源带 hash,长缓存
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # API 反代:不做 rewrite,后端路由自带 /api/v1 前缀
    location /api/v1/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        # keepalive 需要 HTTP/1.1 且清空 Connection(否则每个请求新建连接,
        # LB 压测会把 TIME_WAIT 算进服务端开销)
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # 上传文件由后端静态服务提供
    location /uploads/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # SPA 路由回退:/order/123 刷新时 nginx 找不到文件,回退到 index.html 交给前端路由
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}