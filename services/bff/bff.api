syntax = "v1"

info (
	title:   "demo-shop BFF"
	desc:    "对外 HTTP 收敛层。鉴权:本地 RS256 验签 + identity 透传;不判权。"
	version: "1.0"
)

// ============================================================
// 本文件是 BFF 的唯一契约来源
// ============================================================
//
// 字段名与响应形状**都是从单体 handler 逐个提取的**,不是按 proto 推的。
// 两者不同,原因是单体 handler 手写,做了两件事:
//
// ① proto → model 的字段改名(如 resp.Items → gin.H{"list": ...})
// ② 把 proto 的包装层剥掉(如 resp.Role → utils.Success(c, role))
//
// 故照 proto 的结构写 .api 会得到"前端解不到值但不报错"的接口 ——
// 这类缺陷最难发现。凡有疑问,判据是单体 handler 里
// `utils.Success` 的第二个参数是什么。
//
// ============================================================
// goctl 1.9.2 的语法约束(实测)
// ============================================================
//
//  1. **不支持 `any`**,只认 `interface{}`
//  2. **不支持类型别名** `type X = Y` —— 类型声明必须是 struct 字面量
//  3. **`{ X }` 是 Go 匿名内嵌**,字段会提升,JSON 与展开一致。
//     本文件用它表达"响应就是那个实体",避免把字段抄 4 遍。
//     代价:logic 里要先取值再拷进内嵌字段。
//  4. `returns (int64)` / `returns ([]MenuItem)` 等**标量返回可用**
//
// ============================================================
// 查询参数名是 camelCase(易错)
// ============================================================
//
// 单体的 RBAC 与 category 域用 `c.Query("roleType")` 这类**直接取值**,
// 参数名是 camelCase;而业务域(商品/订单/券)用 request struct 的
// `form` tag,是 snake_case。
//
// **两者不能混**。把 roleType 写成 role_type 的后果是
// httpx.Parse 静默丢弃该参数 → **筛选条件失效,列表返回全部,不报错**。
//
// 故本文件里:
//
// RBAC / category  → camelCase(pageSize / roleType / permType /
//                    menuType / deptType / resourceType)
// 分页参数         → 一律 pageSize(单体全部用 DefaultQuery("pageSize"))
//
// ============================================================
// 中间件:11 个 @server 块全部带 RequestMeta
// ============================================================
//
// RequestMeta 把 client_ip / device 放进 context(登录日志要用),
// 它对**所有**路由生效 —— 包括不鉴权的登录/注册。
//
// 不能把它寄生在 Auth 里:登录挂在 PublicRateLimit 组上、不经过 Auth,
// 而那恰恰是最需要记 IP 的接口(要能看出某个 IP 在爆破)。
//
// **每加一个新的 @server 块都要带上 RequestMeta** —— 漏掉的后果是
// 那个组的登录日志字段为空,而客户端与前端都察觉不到。
// ============================================================
// 通用类型
// ============================================================
type (
	// Empty 无入参 / 无载荷。
	//
	// **注意与单体的差异**:单体那些 `utils.Success(c, nil)` 的接口
	// 返回 `"data": null`,而 returns (Empty) 会生成 `&types.Empty{}`,
	// 序列化成 `"data": {}`。若前端判 `data === null` 会走错分支。
	// 端到端验证时确认一次。
	Empty  {}
	// HealthResp 探活响应
	HealthResp {
		Status string `json:"status"`
	}
)

// ============================================================
// 路径参数类型
// ============================================================
//
// **参数名不能改**:判权将按 c.FullPath() 反查权限码,而 FullPath
// 里含参数名。把 :userId 改成 :id 会让该接口的判权失效。
//
// 分这么多同构的类型(每个域一个)是因为 goctl 的路径参数类型
// 不能跨路由复用得太随意 —— 且这样每个域的类型名自带归属,
// 读 .api 时不用回头找定义。
type (
	AddrIdReq {
		Id int64 `path:"id"`
	}
	UserIdReq {
		Id int64 `path:"id"`
	}
	RoleIdReq {
		Id int64 `path:"id"`
	}
	PermissionIdReq {
		Id int64 `path:"id"`
	}
	MenuIdReq {
		Id int64 `path:"id"`
	}
	ScopeIdReq {
		Id int64 `path:"id"`
	}
	DeptIdReq {
		Id int64 `path:"id"`
	}
	// RelIdReq 五组关联绑定(role_perm / role_menu / menu_perm /
	// user_role / user_dept)的 list 与 clear 共用 :id。
	//
	// 语义随所属路由变:在 /admin/role/:id/perm 下是 role_id,
	// 在 /admin/user/:id/role 下是 user_id。逻辑里显式映射。
	RelIdReq {
		Id int64 `path:"id"`
	}
)

// ============================================================
// 认证
// ============================================================
//
// 响应形状来自单体 user_handler.go 的 gin.H:
//
// Login:        gin.H{"access_token": ..., "refresh_token": ...}
// RefreshToken: gin.H{"access_token": ...}     ← 只有一个
// GetSelfInfo:  gin.H{user_id, username, email, phone, status, profile}
// GetSelfPerms: gin.H{"perms": codes}          ← 键名是 perms
//
// 注意 Register 是 utils.Success(c, user) —— **裸 User 对象**,
// 没有 user 那一层包装。
type (
	RegisterReq {
		Username string `json:"username"`
		Password string `json:"password"`
		Phone    string `json:"phone,optional"`
		Email    string `json:"email,optional"`
		// Nickname 为空时服务端回落为用户名
		Nickname string `json:"nickname,optional"`
	}
	RegisterResp {
		UserId    int64  `json:"user_id"`
		Username  string `json:"username"`
		Email     string `json:"email"`
		Phone     string `json:"phone"`
		Status    string `json:"status"`
		CreatedAt string `json:"created_at"`
		UpdatedAt string `json:"updated_at"`
	}
	LoginReq {
		// Username 与 Phone 二选一,都为空时按用户名查询
		Username string `json:"username,optional"`
		Phone    string `json:"phone,optional"`
		Password string `json:"password"`
	}
	LoginResp {
		AccessToken  string `json:"access_token"`
		RefreshToken string `json:"refresh_token"`
	}
	RefreshTokenReq {
		RefreshToken string `json:"refresh_token"`
	}
	// RefreshTokenResp **只有 access_token** —— refresh 令牌不轮换,
	// 与既有前端行为一致(刷新后前端仍持有旧 refresh_token)
	RefreshTokenResp {
		AccessToken string `json:"access_token"`
	}
	// GetSelfInfoResp 出处 handler/user_handler.go:121 的 gin.H
	GetSelfInfoResp {
		UserId   int64  `json:"user_id"`
		Username string `json:"username"`
		Email    string `json:"email"`
		Phone    string `json:"phone"`
		Status   string `json:"status"`
		// Profile 是**嵌套对象**(UserProfile 本体),不是摊平的字段
		Profile SelfProfile `json:"profile"`
	}
	SelfProfile {
		UserInfoId int64  `json:"user_info_id"`
		UserId     int64  `json:"user_id"`
		Nickname   string `json:"nickname"`
		RealName   string `json:"real_name"`
		Gender     string `json:"gender"`
		AvatarUrl  string `json:"avatar_url"`
		Birthdate  string `json:"birthdate"`
		CreatedAt  string `json:"created_at"`
		UpdatedAt  string `json:"updated_at"`
	}
	// GetSelfPermsResp 出处 handler/user_handler.go:153 gin.H{"perms": codes}
	// **键名是 perms 而不是 proto 的 perm_codes**
	GetSelfPermsResp {
		Perms []string `json:"perms"`
	}
)

// ============================================================
// 用户管理
// ============================================================
//
// **本域的响应形状与其它域都不同**:
//
// 单实体(Get/Create/Update) → 裸 User 对象
// 列表                        → {list, total, page, **pageSize**}
//
// 那个 pageSize 是 camelCase —— 单体 handler 手工写的键名
// (handler/user_handler.go:200),而其它域的列表只有 {list, total}。
type (
	ListUsersReq {
		Page     int    `form:"page,optional"`
		PageSize int    `form:"pageSize,optional"`
		Status   string `form:"status,optional"`
	}
	ListUsersResp {
		List     []UserItem `json:"list"`
		Total    int64      `json:"total"`
		Page     int        `json:"page"`
		PageSize int        `json:"pageSize"`
	}
	UserItem {
		UserId    int64  `json:"user_id"`
		Username  string `json:"username"`
		Email     string `json:"email"`
		Phone     string `json:"phone"`
		Status    string `json:"status"`
		CreatedAt string `json:"created_at"`
		UpdatedAt string `json:"updated_at"`
	}
	GetUserResp {
		UserItem
	}
	CreateUserReq {
		Username string `json:"username"`
		Password string `json:"password"`
		Phone    string `json:"phone,optional"`
		Email    string `json:"email,optional"`
		Status   string `json:"status,optional"`
	}
	CreateUserResp {
		UserItem
	}
	UpdateUserReq {
		Id       int64   `path:"id"`
		Username *string `json:"username,optional"`
		Phone    *string `json:"phone,optional"`
		Email    *string `json:"email,optional"`
		Status   *string `json:"status,optional"`
		Password *string `json:"password,optional"`
	}
	UpdateUserResp {
		UserItem
	}
)

// ============================================================
// 用户档案
// ============================================================
//
// 路由在 /admin/user/info 下但**不判权** —— 授权模型是**归属校验**:
//
// CreateUserInfo: 归属强制为 JWT 里的 userId,请求体里没有这个字段
// 其余 3 条:      JWT 里的 userId 必须等于路径 :id
//
// 前缀里的 "admin" 是历史遗留命名,不代表需要管理员权限。
// **不要因为看到 /admin 就给它加权限码** —— 那会让普通用户改不了自己资料。
//
// 三条的 data 都是 **UserProfile 本体**(单体 utils.Success(c, profile))。
type (
	CreateUserInfoReq {
		Nickname  string `json:"nickname,optional"`
		RealName  string `json:"real_name,optional"`
		Gender    string `json:"gender,optional"`
		AvatarUrl string `json:"avatar_url,optional"`
		Birthdate string `json:"birthdate,optional"`
	}
	CreateUserInfoResp {
		UserInfoId int64  `json:"user_info_id"`
		UserId     int64  `json:"user_id"`
		Nickname   string `json:"nickname"`
		RealName   string `json:"real_name"`
		Gender     string `json:"gender"`
		AvatarUrl  string `json:"avatar_url"`
		Birthdate  string `json:"birthdate"`
		CreatedAt  string `json:"created_at"`
		UpdatedAt  string `json:"updated_at"`
	}
	GetUserInfoResp {
		UserInfoId int64  `json:"user_info_id"`
		UserId     int64  `json:"user_id"`
		Nickname   string `json:"nickname"`
		RealName   string `json:"real_name"`
		Gender     string `json:"gender"`
		AvatarUrl  string `json:"avatar_url"`
		Birthdate  string `json:"birthdate"`
		CreatedAt  string `json:"created_at"`
		UpdatedAt  string `json:"updated_at"`
	}
	UpdateUserInfoReq {
		Id        int64   `path:"id"`
		Nickname  *string `json:"nickname,optional"`
		RealName  *string `json:"real_name,optional"`
		Gender    *string `json:"gender,optional"`
		AvatarUrl *string `json:"avatar_url,optional"`
		Birthdate *string `json:"birthdate,optional"`
	}
	UpdateUserInfoResp {
		UserInfoId int64  `json:"user_info_id"`
		UserId     int64  `json:"user_id"`
		Nickname   string `json:"nickname"`
		RealName   string `json:"real_name"`
		Gender     string `json:"gender"`
		AvatarUrl  string `json:"avatar_url"`
		Birthdate  string `json:"birthdate"`
		CreatedAt  string `json:"created_at"`
		UpdatedAt  string `json:"updated_at"`
	}
)

// ============================================================
// 角色
// ============================================================
//
// 单实体响应是**裸角色对象**(单体 utils.Success(c, role)),
// 故用匿名内嵌 RoleItem 表达 —— 序列化后字段提升,与裸对象一致。
//
// 内嵌的代价:*RoleItem 与 *GetRoleResp 是两个具名类型,
// logic 里不能直接赋值,要先 `item := converter.RoleItem(...)`
// 再 `&types.GetRoleResp{RoleItem: item}`。
type (
	RoleItem {
		RoleId      int64  `json:"role_id"`
		RoleName    string `json:"role_name"`
		RoleType    string `json:"role_type"`
		Description string `json:"description"`
		IsSystem    bool   `json:"is_system"`
		IsDefault   bool   `json:"is_default"`
		DataScope   string `json:"data_scope"`
		CreatedAt   string `json:"created_at"`
	}
	ListRolesReq {
		Page     int    `form:"page,optional"`
		PageSize int    `form:"pageSize,optional"`
		RoleType string `form:"roleType,optional"`
	}
	ListRolesResp {
		List  []RoleItem `json:"list"`
		Total int64      `json:"total"`
	}
	GetRoleResp {
		RoleItem
	}
	CreateRoleReq {
		RoleName    string `json:"role_name"`
		RoleType    string `json:"role_type,optional"`
		Description string `json:"description,optional"`
		DataScope   string `json:"data_scope,optional"`
		IsDefault   bool   `json:"is_default,optional"`
	}
	CreateRoleResp {
		RoleItem
	}
	// UpdateRoleReq 刻意**不含 role_type 与 is_system**:
	// 改 role_type 会让既有 role_perm 绑定的语义不明;
	// is_system 是"不可改不可删"标记,只能由种子数据设置。
	UpdateRoleReq {
		Id          int64   `path:"id"`
		RoleName    *string `json:"role_name,optional"`
		Description *string `json:"description,optional"`
		DataScope   *string `json:"data_scope,optional"`
		IsDefault   *bool   `json:"is_default,optional"`
	}
	UpdateRoleResp {
		RoleItem
	}
)

// ============================================================
// 权限点
// ============================================================
type (
	PermissionItem {
		PermissionId   int64  `json:"permission_id"`
		PermissionCode string `json:"permission_code"`
		PermissionName string `json:"permission_name"`
		PermissionType string `json:"permission_type"`
		RequestMethod  string `json:"request_method"`
		ApiPath        string `json:"api_path"`
		Description    string `json:"description"`
		IsSystem       bool   `json:"is_system"`
	}
	// 过滤参数是 **permType**(不是 permissionType)—— 单体
	// permission_handler.go 是 c.Query("permType")
	ListPermissionsReq {
		Page           int    `form:"page,optional"`
		PageSize       int    `form:"pageSize,optional"`
		PermissionType string `form:"permType,optional"`
	}
	ListPermissionsResp {
		List  []PermissionItem `json:"list"`
		Total int64            `json:"total"`
	}
	GetPermissionResp {
		PermissionItem
	}
	CreatePermissionReq {
		PermissionCode string `json:"permission_code"`
		PermissionName string `json:"permission_name"`
		PermissionType string `json:"permission_type"`
		RequestMethod  string `json:"request_method,optional"`
		// ApiPath 是判权的键,**必须与路由模板逐字一致**(含 :id 等参数名),
		// 且带 /api/v1 前缀。BFF 不校验也不"修正"它 ——
		// 那会让同一个值在两处被不同地解释。
		ApiPath     string `json:"api_path,optional"`
		Description string `json:"description,optional"`
	}
	CreatePermissionResp {
		PermissionItem
	}
	UpdatePermissionReq {
		Id             int64   `path:"id"`
		PermissionName *string `json:"permission_name,optional"`
		ApiPath        *string `json:"api_path,optional"`
		Description    *string `json:"description,optional"`
	}
	UpdatePermissionResp {
		PermissionItem
	}
)

// ============================================================
// 菜单
// ============================================================
//
// MetaInfo 是 google.protobuf.Struct → JSON 对象,故用 interface{}。
// **必须走 AsMap()**:直接序列化 structpb.Struct 会输出
// {"fields": {...}} 这种 protobuf 内部结构,前端解 meta_info.title
// 会全变 undefined。
type (
	MenuItem {
		MenuId    int64       `json:"menu_id"`
		ParentId  int64       `json:"parent_id"`
		MenuName  string      `json:"menu_name"`
		MenuType  string      `json:"menu_type"`
		Icon      string      `json:"icon"`
		RoutePath string      `json:"route_path"`
		Component string      `json:"component"`
		IsVisible bool        `json:"is_visible"`
		IsCache   bool        `json:"is_cache"`
		SortOrder int64       `json:"sort_order"`
		MetaInfo  interface{} `json:"meta_info"`
		CreatedAt string      `json:"created_at"`
		// Children 递归。树查询时填充,列表查询时为空
		// (proto 注释明确写了这一点)。
		Children []MenuItem `json:"children"`
	}
	ListMenusReq {
		Page     int    `form:"page,optional"`
		PageSize int    `form:"pageSize,optional"`
		MenuType string `form:"menuType,optional"`
	}
	ListMenusResp {
		List  []MenuItem `json:"list"`
		Total int64      `json:"total"`
	}
	GetMenuResp {
		MenuItem
	}
	CreateMenuReq {
		ParentId  int64       `json:"parent_id,optional"`
		MenuName  string      `json:"menu_name"`
		MenuType  string      `json:"menu_type"`
		Icon      string      `json:"icon,optional"`
		RoutePath string      `json:"route_path,optional"`
		Component string      `json:"component,optional"`
		IsVisible bool        `json:"is_visible,optional"`
		IsCache   bool        `json:"is_cache,optional"`
		SortOrder int64       `json:"sort_order,optional"`
		MetaInfo  interface{} `json:"meta_info,optional"`
	}
	CreateMenuResp {
		MenuItem
	}
	UpdateMenuReq {
		Id        int64       `path:"id"`
		MenuName  *string     `json:"menu_name,optional"`
		Icon      *string     `json:"icon,optional"`
		RoutePath *string     `json:"route_path,optional"`
		Component *string     `json:"component,optional"`
		IsVisible *bool       `json:"is_visible,optional"`
		IsCache   *bool       `json:"is_cache,optional"`
		SortOrder *int64      `json:"sort_order,optional"`
		MetaInfo  interface{} `json:"meta_info,optional"`
	}
	UpdateMenuResp {
		MenuItem
	}
	// GetMenuTreeByUserIdReq 是 **POST** 且 body 带 user_id
	// (前端登录后生成动态路由)。但 logic **不信任这个字段** ——
	// 它用 JWT 里的身份,否则任何登录用户都能查别人的权限范围。
	GetMenuTreeByUserIdReq {
		UserId int64 `json:"user_id,optional"`
	}
	// GetMenuTreeByRoleIdReq 是 GET,路径参数 :id 的语义是 role_id
	// (角色分配菜单页回显已选)
	GetMenuTreeByRoleIdReq {
		Id int64 `path:"id"`
	}
)

// 两个树查询的响应都是**裸数组**(单体 utils.Success(c, menuTree)),
// 故路由上写 returns ([]MenuItem),不包 {list: [...]}。
// ============================================================
// 部门
// ============================================================
type (
	DeptItem {
		DeptId    int64      `json:"dept_id"`
		ParentId  int64      `json:"parent_id"`
		DeptName  string     `json:"dept_name"`
		DeptType  string     `json:"dept_type"`
		LeaderId  int64      `json:"leader_id"`
		SortOrder int64      `json:"sort_order"`
		Status    string     `json:"status"`
		CreatedAt string     `json:"created_at"`
		Children  []DeptItem `json:"children"`
	}
	ListDeptsReq {
		Page     int    `form:"page,optional"`
		PageSize int    `form:"pageSize,optional"`
		DeptType string `form:"deptType,optional"`
	}
	ListDeptsResp {
		List  []DeptItem `json:"list"`
		Total int64      `json:"total"`
	}
	GetDeptResp {
		DeptItem
	}
	CreateDeptReq {
		ParentId  int64  `json:"parent_id,optional"`
		DeptName  string `json:"dept_name"`
		DeptType  string `json:"dept_type,optional"`
		LeaderId  int64  `json:"leader_id,optional"`
		SortOrder int64  `json:"sort_order,optional"`
		Status    string `json:"status,optional"`
	}
	CreateDeptResp {
		DeptItem
	}
	UpdateDeptReq {
		Id        int64   `path:"id"`
		DeptName  *string `json:"dept_name,optional"`
		DeptType  *string `json:"dept_type,optional"`
		LeaderId  *int64  `json:"leader_id,optional"`
		SortOrder *int64  `json:"sort_order,optional"`
		Status    *string `json:"status,optional"`
	}
	UpdateDeptResp {
		DeptItem
	}
	// GetDeptTreeByUserIdReq 路径参数是 **:userId**(与同组 GET /:id 不同)。
	// 参数名不可改(判权按 FullPath 反查)。
	//
	// 响应同样是**裸数组**(returns ([]DeptItem))。
	//
	// 与菜单树的语义差别:菜单树无权限时返回**空数组**,
	// 而**部门树在用户无所属部门时返回业务错误**(proto 注释写明)。
	GetDeptTreeByUserIdReq {
		UserId int64 `path:"userId"`
	}
)

// ============================================================
// 数据权限
// ============================================================
type (
	ScopeItem {
		ScopeId        int64  `json:"scope_id"`
		RoleId         int64  `json:"role_id"`
		ResourceType   string `json:"resource_type"`
		FieldName      string `json:"field_name"`
		ConditionType  string `json:"condition_type"`
		ConditionValue string `json:"condition_value"`
		Description    string `json:"description"`
		CreatedAt      string `json:"created_at"`
	}
	ListScopesReq {
		Page         int    `form:"page,optional"`
		PageSize     int    `form:"pageSize,optional"`
		ResourceType string `form:"resourceType,optional"`
	}
	ListScopesResp {
		List  []ScopeItem `json:"list"`
		Total int64       `json:"total"`
	}
	GetScopeResp {
		ScopeItem
	}
	CreateScopeReq {
		RoleId         int64  `json:"role_id"`
		ResourceType   string `json:"resource_type"`
		FieldName      string `json:"field_name,optional"`
		ConditionType  string `json:"condition_type,optional"`
		ConditionValue string `json:"condition_value,optional"`
		Description    string `json:"description,optional"`
	}
	CreateScopeResp {
		ScopeItem
	}
	UpdateScopeReq {
		Id             int64   `path:"id"`
		ResourceType   *string `json:"resource_type,optional"`
		FieldName      *string `json:"field_name,optional"`
		ConditionType  *string `json:"condition_type,optional"`
		ConditionValue *string `json:"condition_value,optional"`
		Description    *string `json:"description,optional"`
	}
	UpdateScopeResp {
		ScopeItem
	}
)

// ============================================================
// 五组关联绑定
// ============================================================
//
// 五组结构同构:assign(POST,全量替换)/ list(GET)/ clear(DELETE)。
//
// **assign 是"先清空再写入",不是追加** —— 前端传的必须是完整集合:
//
// 原本 [1,2] 想加 3 → 传 [1,2,3] ✅;传 [3] ❌ (1,2 被清掉)
//
// 空数组是合法输入(表示清空),**不要拦** —— 前端"全部取消勾选后
// 保存"会用到。
//
// **assign 的响应**:单体是 utils.Success(c, req) —— **回显请求体**。
// 而这里写的是 returns (Empty)(回 {})。原因:写
// returns (AssignRolePermsReq) 会让 goctl 生成"入参与出参同类型"的
// 签名,能编译但读代码时看不出是回显。
//
// **这是与单体的已知可见差异**,端到端验证时确认前端是否依赖回显。
type (
	AssignRolePermsReq {
		RoleId  int64   `json:"role_id"`
		PermIds []int64 `json:"perm_ids"`
	}
	AssignRoleMenusReq {
		RoleId  int64   `json:"role_id"`
		MenuIds []int64 `json:"menu_ids"`
	}
	AssignMenuPermsReq {
		MenuId  int64   `json:"menu_id"`
		PermIds []int64 `json:"perm_ids"`
	}
	AssignUserRolesReq {
		UserId  int64   `json:"user_id"`
		RoleIds []int64 `json:"role_ids"`
	}
	AssignUserDeptsReq {
		UserId  int64   `json:"user_id"`
		DeptIds []int64 `json:"dept_ids"`
		// PrimaryIndex 主部门在 dept_ids 中的**下标**,不是部门ID。
		// 越界或为负表示无主部门。
		//
		// **不要"顺手修正"成 ID**:服务端按下标解析,传 ID 会被当成下标 ——
		// 若 ID 恰好落在 [0, len) 区间会静默选错主部门。
		PrimaryIndex int64 `json:"primary_index,optional"`
	}
	ListRolePermsResp {
		List  []PermissionItem `json:"list"`
		Total int64            `json:"total"`
	}
	ListRoleMenusResp {
		List  []MenuItem `json:"list"`
		Total int64      `json:"total"`
	}
	ListMenuPermsResp {
		List  []PermissionItem `json:"list"`
		Total int64            `json:"total"`
	}
	ListUserRolesResp {
		List  []RoleItem `json:"list"`
		Total int64      `json:"total"`
	}
	ListUserDeptsResp {
		List  []DeptItem `json:"list"`
		Total int64      `json:"total"`
		// PrimaryDeptId 主部门的**部门ID**,无主部门时为 0。
		//
		// 与 AssignUserDeptsReq.PrimaryIndex 不是一个东西:
		// 一个下标、一个 ID。前端典型用法是把 dept_id == primary_dept_id
		// 的那一项标为"主部门"。
		PrimaryDeptId int64 `json:"primary_dept_id"`
	}
)

// ============================================================
// 地址域
// ============================================================
//
// **地址域与 RBAC 域的响应形状约定不同** —— 单体 address_handler.go:
//
// CreateAddress    → Success(c, addressId)    裸数字
// GetAddressList   → Success(c, addressList)  裸数组
// GetAddress       → Success(c, address)      裸对象
// UpdateAddress    → Success(c, address)      裸对象
// DeleteAddress    → Success(c, nil)          null
// SetDefaultAddress→ Success(c, nil)          null
//
// 即:**全是裸值,没有任何包装**。而 RBAC 的列表是
// gin.H{"list": ..., "total": ...}。两者不能互相类推。
//
// 故地址域的列表是 returns ([]AddressItem)(裸数组,无 total),
// 单实体是内嵌 AddressItem(裸对象)。
//
// CreatedAt 是 **string**:单体 response.AddressResp 用
// time.Time.String() 格式化,前端直接展示(不是 proto 的 Timestamp)。
type (
	AddressItem {
		AddressId     int64  `json:"address_id"`
		ReceiverName  string `json:"receiver_name"`
		ReceiverPhone string `json:"receiver_phone"`
		Province      string `json:"province"`
		City          string `json:"city"`
		District      string `json:"district"`
		DetailAddress string `json:"detail_address"`
		PostalCode    string `json:"postal_code"`
		IsDefault     bool   `json:"is_default"`
		AddressTag    string `json:"address_tag"`
		CreatedAt     string `json:"created_at"`
	}
	CreateAddressReq {
		ReceiverName  string `json:"receiver_name"`
		ReceiverPhone string `json:"receiver_phone"`
		Province      string `json:"province"`
		City          string `json:"city"`
		District      string `json:"district"`
		DetailAddress string `json:"detail_address"`
		PostalCode    string `json:"postal_code,optional"`
		IsDefault     bool   `json:"is_default,optional"`
		AddressTag    string `json:"address_tag,optional"`
	}
	// 单实体响应:裸对象(匿名内嵌),不是 {address: {...}}
	GetAddressResp {
		AddressItem
	}
	UpdateAddressReq {
		Id            int64   `path:"id"`
		ReceiverName  *string `json:"receiver_name,optional"`
		ReceiverPhone *string `json:"receiver_phone,optional"`
		Province      *string `json:"province,optional"`
		City          *string `json:"city,optional"`
		District      *string `json:"district,optional"`
		DetailAddress *string `json:"detail_address,optional"`
		PostalCode    *string `json:"postal_code,optional"`
		IsDefault     *bool   `json:"is_default,optional"`
		AddressTag    *string `json:"address_tag,optional"`
	}
	UpdateAddressResp {
		AddressItem
	}
)

// ============================================================
// 路由:免登录 + IP 限流(register / login)
// ============================================================
//
// 单体 userPublic 组没挂中间件,但这两条**路由级**挂了 PerIPRateLimit。
// go-zero 的 .api 不支持路由级中间件,故用独立组表达 —— 效果等价,
// 且限流发生在进业务之前。
@server (
	prefix:     /api/v1/user
	group:      user
	middleware: RequestMeta,PublicRateLimit
)
service bff {
	@handler Register
	post /register (RegisterReq) returns (RegisterResp)

	@handler Login
	post /login (LoginReq) returns (LoginResp)
}

// ============================================================
// 路由:免登录(refresh / healthz)
// ============================================================
// refresh **既不限流也不验签**:纯转发给 user-service 由它自行验签
// (它持私钥,能区分 access/refresh)。DS-A-26 §六 明确写了这条 ——
// 提前在任一侧删掉验签,会让未迁移模块整片 401。
@server (
	prefix:     /api/v1/user
	group:      user
	middleware: RequestMeta,Public
)
service bff {
	@handler RefreshToken
	post /refresh (RefreshTokenReq) returns (RefreshTokenResp)
}

// healthz 不挂 Auth(探针不该需要令牌),但要挂 RequestMeta ——
// 保持一致,且限流中间件里有个按路径豁免 healthz 的逻辑依赖
// FullPath 的形态。
@server (
	prefix:     /api/v1
	group:      health
	middleware: RequestMeta,Public
)
service bff {
	@handler Health
	get /healthz (Empty) returns (HealthResp)
}

// ============================================================
// 路由:登录即可 —— 用户自助
// ============================================================
@server (
	prefix:     /api/v1/user
	group:      user
	middleware: RequestMeta,Auth
)
service bff {
	@handler GetSelfInfo
	get /info (Empty) returns (GetSelfInfoResp)

	@handler GetSelfPerms
	get /perms (Empty) returns (GetSelfPermsResp)
}

// ============================================================
// 路由:登录即可 —— 地址域
// ============================================================
@server (
	prefix:     /api/v1/addresses
	group:      address
	middleware: RequestMeta,Auth
)
service bff {
	// data 是**裸数字**(单体 utils.Success(c, addressId))
	@handler CreateAddress
	post / (CreateAddressReq) returns (int64)

	// 地址域的列表是**裸数组**(单体 Success(c, addressList)),
	// 没有 {list: ..., total: ...} 包装,也没有 total ——
	// 与 RBAC 域的列表形状不同,见上方地址域说明。
	@handler ListAddresses
	get / (Empty) returns ([]AddressItem)

	@handler GetAddress
	get /:id (AddrIdReq) returns (GetAddressResp)

	@handler UpdateAddress
	put /:id (UpdateAddressReq) returns (UpdateAddressResp)

	@handler DeleteAddress
	delete /:id (AddrIdReq) returns (Empty)

	// 参数名 :id 与方法 PUT —— 单体是 PUT /:id/default
	@handler SetDefaultAddress
	put /:id/default (AddrIdReq) returns (Empty)
}

// ============================================================
// 路由:登录即可 —— 管理端(不判权,权限码留后续)
// ============================================================
//
// 判权实现时按 c.FullPath() + Method 反查权限码(与单体 auth.go 同一手法),
// 故路径模板(含参数名)与方法必须逐字照抄。
@server (
	prefix:     /api/v1/admin/user
	group:      user
	middleware: RequestMeta,Auth
)
service bff {
	@handler ListUsers
	get / (ListUsersReq) returns (ListUsersResp)

	@handler CreateUser
	post / (CreateUserReq) returns (CreateUserResp)

	// go-zero 按静态段优先,/:id 不会吞掉 /assign-role 与 /assign-dept
	@handler AssignUserRole
	post /assign-role (AssignUserRolesReq) returns (Empty)

	@handler AssignUserDept
	post /assign-dept (AssignUserDeptsReq) returns (Empty)

	@handler GetUser
	get /:id (UserIdReq) returns (GetUserResp)

	@handler UpdateUser
	put /:id (UpdateUserReq) returns (UpdateUserResp)

	@handler DeleteUser
	delete /:id (UserIdReq) returns (Empty)

	@handler ListUserRoles
	get /:id/role (RelIdReq) returns (ListUserRolesResp)

	@handler ClearUserRoles
	delete /:id/clear-role (RelIdReq) returns (Empty)

	@handler ListUserDepts
	get /:id/dept (RelIdReq) returns (ListUserDeptsResp)

	@handler ClearUserDepts
	delete /:id/clear-dept (RelIdReq) returns (Empty)
}

// 用户档案:**管理端前缀但本人可读写**,不判权,归属校验在 logic
@server (
	prefix:     /api/v1/admin/user/info
	group:      user
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreateUserInfo
	post /create (CreateUserInfoReq) returns (CreateUserInfoResp)

	@handler GetUserInfo
	get /:id (UserIdReq) returns (GetUserInfoResp)

	@handler UpdateUserInfo
	put /:id (UpdateUserInfoReq) returns (UpdateUserInfoResp)

	@handler DeleteUserInfo
	delete /:id (UserIdReq) returns (Empty)
}

@server (
	prefix:     /api/v1/admin/role
	group:      role
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreateRole
	post / (CreateRoleReq) returns (CreateRoleResp)

	@handler ListRoles
	get / (ListRolesReq) returns (ListRolesResp)

	@handler AssignRolePerms
	post /assign-perm (AssignRolePermsReq) returns (Empty)

	@handler AssignRoleMenus
	post /assign-menu (AssignRoleMenusReq) returns (Empty)

	@handler GetRole
	get /:id (RoleIdReq) returns (GetRoleResp)

	@handler UpdateRole
	put /:id (UpdateRoleReq) returns (UpdateRoleResp)

	@handler DeleteRole
	delete /:id (RoleIdReq) returns (Empty)

	@handler ListRolePerms
	get /:id/perm (RelIdReq) returns (ListRolePermsResp)

	@handler ClearRolePerms
	delete /:id/clear-perm (RelIdReq) returns (Empty)

	@handler ListRoleMenus
	get /:id/menu (RelIdReq) returns (ListRoleMenusResp)

	@handler ClearRoleMenus
	delete /:id/clear-menu (RelIdReq) returns (Empty)
}

@server (
	prefix:     /api/v1/admin/permissions
	group:      permission
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreatePermission
	post / (CreatePermissionReq) returns (CreatePermissionResp)

	@handler ListPermissions
	get / (ListPermissionsReq) returns (ListPermissionsResp)

	@handler GetPermission
	get /:id (PermissionIdReq) returns (GetPermissionResp)

	@handler UpdatePermission
	put /:id (UpdatePermissionReq) returns (UpdatePermissionResp)

	@handler DeletePermission
	delete /:id (PermissionIdReq) returns (Empty)
}

@server (
	prefix:     /api/v1/admin/menu
	group:      menu
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreateMenu
	post / (CreateMenuReq) returns (CreateMenuResp)

	@handler ListMenus
	get / (ListMenusReq) returns (ListMenusResp)

	// **管理端前缀但刻意不判权**:前端登录后要立刻拿动态路由,
	// 此时权限码可能还没加载完 —— 若这条也判权会死锁
	// (要拿菜单得先有权限,要有权限得先拿菜单)。
	// 服务端按 userId 过滤,故不泄露别人能看什么。
	@handler GetMenuTreeByUserId
	post /tree (GetMenuTreeByUserIdReq) returns ([]MenuItem)

	@handler AssignMenuPerms
	post /assign-perm (AssignMenuPermsReq) returns (Empty)

	@handler GetMenu
	get /:id (MenuIdReq) returns (GetMenuResp)

	// 路径参数 :id 的语义是 role_id
	@handler GetMenuTreeByRoleId
	get /:id/tree (GetMenuTreeByRoleIdReq) returns ([]MenuItem)

	@handler UpdateMenu
	put /:id (UpdateMenuReq) returns (UpdateMenuResp)

	@handler DeleteMenu
	delete /:id (MenuIdReq) returns (Empty)

	@handler ListMenuPerms
	get /:id/perm (RelIdReq) returns (ListMenuPermsResp)

	@handler ClearMenuPerms
	delete /:id/clear-perm (RelIdReq) returns (Empty)
}

@server (
	prefix:     /api/v1/admin/scope
	group:      scope
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreateScope
	post / (CreateScopeReq) returns (CreateScopeResp)

	@handler ListScopes
	get / (ListScopesReq) returns (ListScopesResp)

	@handler GetScope
	get /:id (ScopeIdReq) returns (GetScopeResp)

	@handler UpdateScope
	put /:id (UpdateScopeReq) returns (UpdateScopeResp)

	@handler DeleteScope
	delete /:id (ScopeIdReq) returns (Empty)
}

@server (
	prefix:     /api/v1/admin/dept
	group:      dept
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreateDept
	post / (CreateDeptReq) returns (CreateDeptResp)

	@handler ListDepts
	get / (ListDeptsReq) returns (ListDeptsResp)

	// 参数名 :userId —— 与同组 GET /:id 不同,必须保留
	@handler GetDeptTreeByUserId
	get /tree/:userId (GetDeptTreeByUserIdReq) returns ([]DeptItem)

	@handler GetDept
	get /:id (DeptIdReq) returns (GetDeptResp)

	@handler UpdateDept
	put /:id (UpdateDeptReq) returns (UpdateDeptResp)

	@handler DeleteDept
	delete /:id (DeptIdReq) returns (Empty)
}

// ============================================================================
// ============================================================================
// 订单域(trade-service)
// ============================================================================
// ============================================================================
//
// ============================================================
// 响应形状的来源:单体 model/response/*.go,不是 proto
// ============================================================
//
// 这是订单域最重要的一条。单体的 tradeclient 把 proto 转成了
// **专为 HTTP 定义的** response.* 结构体,而那一步做了三类改动:
//
// ① 改名   proto total_price → http subtotal
//           proto available   → http is_available
//           proto selected_items → http items
//           proto details     → http detail_list
//           proto logs        → http log_list
// ② 类型   proto spec_values 是 **JSON 文本字符串**,
//           http 是 **JSONMap(对象)**
//           proto address_snapshot 是**字符串**,
//           http 是 **datatypes.JSON(对象)**
// ③ 隐藏   proto 的 user_id / created_at / updated_at / sku_status /
//           spu_status 在 http 里是 `json:"-"`(不返回)
//           proto 的 expire_at / idempotent_key 不返回
//
// **照 proto 写 .api 会让前端大面积拿到 undefined**,而且不报错。
// 故下面每个类型都标注了它对应单体 response 里的哪个结构体。
//
// ============================================================
// 三处 HTTP 有而 proto 没有的字段(BFF 要自己算)
// ============================================================
//
//   GetCartPayPreview 的 total_count / has_unavailable / unavailable_items
//     proto 的 CartPayPreview 只有 selected_items / total_quantity /
//     total_amount —— 另外三个由单体 tradeclient 在转换时算出。
//
//   GetOrderList(管理端)的 receiver_name / receiver_phone
//     来自解析 address_snapshot 那个 JSON 字符串。
//
//   GetOrder(管理端)的 user_id / username
//     proto 的 GetOrderResp.username 有,user_id 要从 Order.user_id 取。
//
// ============================================================
// 购物车协议的特殊之处:CreateCartItem 返回被降级了
// ============================================================
//
// proto 的 CreateCartItemResp 返回**整行 CartItem**(注释:"前端不必再
// 拉一次列表"),而单体把它降级成了 {cart_item_id, quantity}。
//
// BFF **保持单体的降级**(前端零感知)。要升回整行是一次契约变更,
// 应当单独做并通知前端 —— 虽然前端大概率会欢迎(少一次列表请求)。
// ============================================================
// 购物车
// ============================================================
type (
	// CartItem 对应单体 response.CartItemListResp
	CartItem {
		CartItemId int64  `json:"cart_item_id"`
		SkuId      int64  `json:"sku_id"`
		SpuId      int64  `json:"spu_id"`
		SpuName    string `json:"spu_name"`
		MainImage  string `json:"main_image"`
		SkuName    string `json:"sku_name"`
		// SpecValues 是**对象**,不是字符串 —— proto 那边是 JSON 文本,
		// 需要解析(单体用 jsonTextToMap)。
		//
		// 解析失败时返回**空对象**并记日志,不报错:它只是规格展示
		// (如"红色:XL"),不该让整个购物车列表失败,而空对象前端能容错。
		// 这是一个**刻意的静默降级**,与项目里"未知错误落到 500"的
		// 原则相反,故在此写明。
		SpecValues interface{} `json:"spec_values"`
		SkuImage   string      `json:"sku_image"`
		Price      float64     `json:"price"`
		Stock      int64       `json:"stock"`
		Quantity   int64       `json:"quantity"`
		IsSelected bool        `json:"is_selected"`
		// Subtotal 来自 proto 的 total_price(改名)
		Subtotal float64 `json:"subtotal"`
		// IsAvailable 来自 proto 的 available(改名)
		IsAvailable bool `json:"is_available"`
		// UnavailableReason available=true 时为空串
		UnavailableReason string `json:"unavailable_reason"`
	}
	// AddCartItemReq 单体收 {sku_id, quantity}(用户从 JWT 取)
	AddCartItemReq {
		SkuId    int64 `json:"sku_id"`
		Quantity int64 `json:"quantity"`
	}
	// AddCartItemResp 单体降级后的形状(见上方说明)
	AddCartItemResp {
		CartItemId int64 `json:"cart_item_id"`
		Quantity   int64 `json:"quantity"`
	}
	// ListCartItemsResp 不用它 —— 那条路由返回**裸数组**
	// (`returns ([]CartItem)`),因为单体是 utils.Success(c, resp),
	// 而 resp 就是 []response.CartItemListResp。
	CartItemIdReq {
		Id int64 `path:"id"`
	}
	// UpdateCartItemReq 整条更新,**不是部分更新**。
	//
	// 单体是 c.ShouldBindJSON(&updateCartItem) 后把两个字段原样传给
	// RPC(requset.UpdateCartItemReq 是**非指针**的 int64 / bool)——
	// 即它**不区分"没传"与"传了零值"**:
	//
	// 只传 {"quantity": 3}  → is_selected 是 false,
	//                         会把已勾选的商品**取消勾选**
	//
	// 所以前端改数量时**必须把 is_selected 一起传**。
	//
	// **故这里两个字段都不是 optional** —— 标 optional 会让实现者
	// 以为需要区分"没传",从而发明一套单体与前端都没有的语义。
	UpdateCartItemReq {
		Id         int64 `path:"id"`
		Quantity   int64 `json:"quantity"`
		IsSelected bool  `json:"is_selected"`
	}
	// SelectAllCartReq 单体收 {is_selected}
	SelectAllCartReq {
		IsSelected bool `json:"is_selected"`
	}
	// SelectAllCartResp 单体:gin.H{"affected": total}
	SelectAllCartResp {
		Affected int64 `json:"affected"`
	}
	// CartCountResp 单体:gin.H{"count": total}
	CartCountResp {
		Count int64 `json:"count"`
	}
	// CartPayPreviewResp 对应单体 response.CartItemPayResp
	//
	// proto 的 CartPayPreview 只有 selected_items / total_quantity /
	// total_amount;另三个字段(total_count / has_unavailable /
	// unavailable_items)由 BFF 计算。
	//
	// **注意 Items 是包装的(不是裸数组)** —— 与 GetCartItemList
	// 不同。单体这里就是 gin 序列化一个 struct,故有 items 键。
	CartPayPreviewResp {
		Items          []CartItem `json:"items"`
		TotalCount     int64      `json:"total_count"`
		TotalQuantity  int64      `json:"total_quantity"`
		TotalAmount    float64    `json:"total_amount"`
		HasUnavailable bool       `json:"has_unavailable"`
		// UnavailableItems 前端用它渲染"以下商品不可购买"的提示区
		UnavailableItems []CartItem `json:"unavailable_items"`
	}
)

// ============================================================
// 订单
// ============================================================
type (
	// OrderDetail 对应单体 response.UserGetOrderDetail
	OrderDetail {
		DetailId   int64   `json:"detail_id"`
		SkuId      int64   `json:"sku_id"`
		SpuName    string  `json:"spu_name"`
		SkuName    string  `json:"sku_name"`
		SpecValues string  `json:"spec_values"`
		MainImage  string  `json:"main_image"`
		Quantity   int64   `json:"quantity"`
		UnitPrice  float64 `json:"unit_price"`
		TotalPrice float64 `json:"total_price"`
	}
	// OrderLog 对应单体 response.UserGetOrderLog
	OrderLog {
		LogId       int64  `json:"log_id"`
		OrderId     int64  `json:"order_id"`
		OrderStatus string `json:"order_status"`
		Action      string `json:"action"`
		Operator    string `json:"operator"`
		Detail      string `json:"detail"`
		CreatedAt   string `json:"created_at"`
	}
	// CreateOrderReq 单体的 requset.CreatOrderReq
	//
	// **address_id 是给 BFF 用的,不传给 trade** ——
	// BFF 先用它调 user-service 的 GetAddressSnapshot 取地址快照,
	// 再把快照传给 trade 的 CreateOrder。
	//
	// 为什么不直接传 address_id 让 trade 自己查:地址表在 user_db,
	// trade 跨库读不到;而且订单存的是**下单那一刻**的地址快照,
	// 由调用方从权威源取一次再传,语义最贴切。
	CreateOrderReq {
		AddressId int64 `json:"address_id"`
		// IdempotentKey 由**前端生成**(UUID),全局唯一 ——
		// 它是所有跨服务操作的幂等判据,不是 order_no。
		IdempotentKey string `json:"idempotent_key"`
		BuyerRemark   string `json:"buyer_remark,optional"`
		UserCouponId  int64  `json:"user_coupon_id,optional"`
	}
	// CreateOrderResp 对应单体 response.CreateOrderResp
	CreateOrderResp {
		OrderId     int64   `json:"order_id"`
		OrderNo     string  `json:"order_no"`
		PayAmount   float64 `json:"pay_amount"`
		TotalAmount float64 `json:"total_amount"`
		OrderStatus string  `json:"order_status"`
		PayExpireAt string  `json:"pay_expire_at"`
		CreatedAt   string  `json:"created_at"`
	}
	// UserOrderListItem 对应单体 response.UserGetOrderList
	UserOrderListItem {
		OrderId     int64   `json:"order_id"`
		OrderNo     string  `json:"order_no"`
		OrderStatus string  `json:"order_status"`
		TotalAmount float64 `json:"total_amount"`
		PayAmount   float64 `json:"pay_amount"`
		DetailCount int64   `json:"detail_count"`
		FirstImage  string  `json:"first_image"`
		CreatedAt   string  `json:"created_at"`
	}
	// ListUserOrdersReq 查询参数是 **snake_case**(订单域用 request
	// struct 的 form tag,与 RBAC 域的 c.Query camelCase 不同)
	ListUserOrdersReq {
		Page        int    `form:"page,optional"`
		PageSize    int    `form:"page_size,optional"`
		OrderStatus string `form:"order_status,optional"`
	}
	// ListUserOrdersResp 对应单体 response.UserGetOrderListResp
	ListUserOrdersResp {
		List     []UserOrderListItem `json:"list"`
		Total    int64               `json:"total"`
		Page     int                 `json:"page"`
		PageSize int                 `json:"page_size"`
	}
	OrderIdReq {
		Id int64 `path:"id"`
	}
	// GetUserOrderResp 对应单体 response.UserGetOrderResp
	//
	// AddressSnapshot 是**对象**(单体的 datatypes.JSON)—— proto 那边
	// 是字符串,需要解析。
	//
	// 注意 details/logs 在 HTTP 里叫 **detail_list / log_list**。
	GetUserOrderResp {
		OrderId         int64         `json:"order_id"`
		OrderNo         string        `json:"order_no"`
		OrderStatus     string        `json:"order_status"`
		TotalAmount     float64       `json:"total_amount"`
		PayAmount       float64       `json:"pay_amount"`
		PayMethod       string        `json:"pay_method"`
		PayTime         string        `json:"pay_time"`
		AddressSnapshot interface{}   `json:"address_snapshot"`
		BuyerRemark     string        `json:"buyer_remark"`
		DetailList      []OrderDetail `json:"detail_list"`
		LogList         []OrderLog    `json:"log_list"`
		CreatedAt       string        `json:"created_at"`
	}
	// CancelOrderResp 对应单体 response.OrderStatusResp
	CancelOrderResp {
		OrderId     int64  `json:"order_id"`
		OrderNo     string `json:"order_no"`
		OrderStatus string `json:"order_status"`
	}
	// ConfirmOrderResp 同上(ConfirmOrder 也返回 OrderStatusResp)
	ConfirmOrderResp {
		OrderId     int64  `json:"order_id"`
		OrderNo     string `json:"order_no"`
		OrderStatus string `json:"order_status"`
	}
)

// ============================================================
// 订单(管理端)
// ============================================================
type (
	// AdminOrderListItem 对应单体 response.GetOrderList
	//
	// ReceiverName / ReceiverPhone **来自解析 address_snapshot** ——
	// proto 的 Order 没有这两个字段,BFF 要从那个 JSON 字符串里取。
	AdminOrderListItem {
		OrderId       int64   `json:"order_id"`
		OrderNo       string  `json:"order_no"`
		OrderStatus   string  `json:"order_status"`
		TotalAmount   float64 `json:"total_amount"`
		PayAmount     float64 `json:"pay_amount"`
		PayMethod     string  `json:"pay_method"`
		UserName      string  `json:"user_name"`
		ReceiverName  string  `json:"receiver_name"`
		ReceiverPhone string  `json:"receiver_phone"`
		CreatedAt     string  `json:"created_at"`
	}
	// ListOrdersReq 对应单体 requset.GetOrderListReq(snake_case)
	ListOrdersReq {
		Page        int    `form:"page,optional"`
		PageSize    int    `form:"page_size,optional"`
		OrderStatus string `form:"order_status,optional"`
		OrderNo     string `form:"order_no,optional"`
		StartTime   string `form:"start_time,optional"`
		EndTime     string `form:"end_time,optional"`
	}
	// ListOrdersResp 对应单体 response.GetOrderListResp
	//
	// **注意字段顺序无关,但键名有 page/page_size/total/list** ——
	// 与用户端的 ListUserOrdersResp 键名相同,故这里可以用同一个类型。
	// 但两者元素不同(这个带 user_name/receiver_*),故分开定义。
	ListOrdersResp {
		Page     int                  `json:"page"`
		PageSize int                  `json:"page_size"`
		Total    int64                `json:"total"`
		List     []AdminOrderListItem `json:"list"`
	}
	// GetOrderResp 对应单体 response.GetOrderResp
	//
	// 比用户端多了 user_id / username。
	GetOrderResp {
		OrderId         int64         `json:"order_id"`
		OrderNo         string        `json:"order_no"`
		OrderStatus     string        `json:"order_status"`
		TotalAmount     float64       `json:"total_amount"`
		PayAmount       float64       `json:"pay_amount"`
		PayMethod       string        `json:"pay_method"`
		PayTime         string        `json:"pay_time"`
		AddressSnapshot interface{}   `json:"address_snapshot"`
		BuyerRemark     string        `json:"buyer_remark"`
		DetailList      []OrderDetail `json:"detail_list"`
		LogList         []OrderLog    `json:"log_list"`
		CreatedAt       string        `json:"created_at"`
		Username        string        `json:"username"`
		UserId          int64         `json:"user_id"`
	}
	// ShipOrderReq 单体收 {express_company, tracking_no};:id 是 order_id。
	// 操作人(username)从 JWT 取。
	ShipOrderReq {
		Id             int64  `path:"id"`
		ExpressCompany string `json:"express_company"`
		TrackingNo     string `json:"tracking_no"`
	}
	// ShipOrderResp 对应单体 response.OrderShipResp
	ShipOrderResp {
		OrderId        int64  `json:"order_id"`
		OrderNo        string `json:"order_no"`
		OrderStatus    string `json:"order_status"`
		ExpressCompany string `json:"express_company"`
		TrackingNo     string `json:"tracking_no"`
	}
)

// ============================================================
// 支付
// ============================================================
type (
	// CreatePaymentReq 单体收 {pay_method};:id 是 order_id
	CreatePaymentReq {
		Id        int64  `path:"id"`
		PayMethod string `json:"pay_method"`
	}
	// CreatePaymentResp 对应单体 response.CreatePaymentResp
	//
	// 注意 pay_url / qr_code 在单体带 `omitempty` —— 空时不出现该键。
	// goctl 不支持 omitempty,故这里它们**总是出现**(值为空串)。
	// 前端若用 `'pay_url' in data` 判断,行为会变;若用 truthy 判断则无影响。
	CreatePaymentResp {
		PaymentId int64   `json:"payment_id"`
		PayNo     string  `json:"pay_no"`
		PayAmount float64 `json:"pay_amount"`
		PayStatus string  `json:"pay_status"`
		PayUrl    string  `json:"pay_url"`
		QrCode    string  `json:"qr_code"`
	}
	// GetPaymentReq 路径参数是 :payNo
	GetPaymentReq {
		PayNo string `path:"payNo"`
	}
	// GetPaymentResp 对应单体 response.GetPaymentResp
	GetPaymentResp {
		PaymentId int64   `json:"payment_id"`
		PayNo     string  `json:"pay_no"`
		OrderId   int64   `json:"order_id"`
		OrderNo   string  `json:"order_no"`
		PayMethod string  `json:"pay_method"`
		PayAmount float64 `json:"pay_amount"`
		PayStatus string  `json:"pay_status"`
		PayTime   string  `json:"pay_time"`
		TradeNo   string  `json:"trade_no"`
	}
	// MockCallbackReq 单体从 JSON body 取 {pay_no, trade_no}
	MockCallbackReq {
		PayNo   string `json:"pay_no"`
		TradeNo string `json:"trade_no,optional"`
	}
	// AdminPaymentListItem 对应单体 response.GetPaymentList
	AdminPaymentListItem {
		PaymentId int64   `json:"payment_id"`
		PayNo     string  `json:"pay_no"`
		OrderNo   string  `json:"order_no"`
		Username  string  `json:"username"`
		PayMethod string  `json:"pay_method"`
		PayAmount float64 `json:"pay_amount"`
		PayStatus string  `json:"pay_status"`
		PayTime   string  `json:"pay_time"`
	}
	// ListPaymentsReq 对应单体 requset.GetPaymentListReq(snake_case)
	//
	// 注意 page_size **默认 20**(不是订单列表的 10)——
	// 单体 handler 的注释写明"默认20,最大100"。
	ListPaymentsReq {
		Page      int    `form:"page,optional"`
		PageSize  int    `form:"page_size,optional"`
		PayStatus string `form:"pay_status,optional"`
		PayMethod string `form:"pay_method,optional"`
		OrderNo   string `form:"order_no,optional"`
		StartTime string `form:"start_time,optional"`
		EndTime   string `form:"end_time,optional"`
	}
	// ListPaymentsResp 对应单体 response.GetPaymentListResp
	ListPaymentsResp {
		List     []AdminPaymentListItem `json:"list"`
		Total    int64                  `json:"total"`
		Page     int                    `json:"page"`
		PageSize int                    `json:"page_size"`
	}
)

// ============================================================
// 路由:购物车
// ============================================================
@server (
	prefix:     /api/v1/cart
	group:      cart
	middleware: RequestMeta,Auth
)
service bff {
	@handler AddCartItem
	post / (AddCartItemReq) returns (AddCartItemResp)

	// 裸数组(单体 utils.Success(c, resp),resp 是切片)
	@handler ListCartItems
	get / (Empty) returns ([]CartItem)

	// 注意 /count 与 /preview 是静态段,go-zero 按静态优先,
	// 不会被 /:id 吞掉
	@handler GetCartCount
	get /count (Empty) returns (CartCountResp)

	@handler GetCartPayPreview
	get /preview (Empty) returns (CartPayPreviewResp)

	@handler UpdateCartItem
	put /:id (UpdateCartItemReq) returns (CartItem)

	// select-all 与 /:id 都是 PUT;静态段优先,故不冲突
	@handler SelectAllCart
	put /select-all (SelectAllCartReq) returns (SelectAllCartResp)

	@handler DeleteCartItem
	delete /:id (CartItemIdReq) returns (Empty)
}

// ============================================================
// 路由:用户订单
// ============================================================
@server (
	prefix:     /api/v1/orders
	group:      order
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreateOrder
	post / (CreateOrderReq) returns (CreateOrderResp)

	@handler ListUserOrders
	get / (ListUserOrdersReq) returns (ListUserOrdersResp)

	@handler GetUserOrder
	get /:id (OrderIdReq) returns (GetUserOrderResp)

	// 参数名 :id 与方法 PUT —— 单体是 PUT /:id/cancel
	@handler CancelOrder
	put /:id/cancel (OrderIdReq) returns (CancelOrderResp)

	@handler ConfirmOrder
	put /:id/confirm (OrderIdReq) returns (ConfirmOrderResp)
}

// ============================================================
// 路由:用户支付
// ============================================================
@server (
	prefix:     /api/v1/pay
	group:      payment
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreatePayment
	post /order/:id (CreatePaymentReq) returns (CreatePaymentResp)

	// 参数名 :payNo(不是 :id)—— 必须保留
	@handler GetPayment
	get /:payNo (GetPaymentReq) returns (GetPaymentResp)
}

// 支付渠道回调:**免鉴权**(渠道不会带我们的令牌)。
//
// **错误语义特殊**:单体 MockCallback 是 utils.Success(c, nil),
// 而真实渠道回调的约定是"返回非 2xx = 请重试回调"。
// 故这条路由的失败必须让渠道能区分"受理了"与"没受理"。
@server (
	prefix:     /api/v1/pay
	group:      payment
	middleware: RequestMeta,Public
)
service bff {
	@handler MockPaymentCallback
	post /callback/mock (MockCallbackReq) returns (Empty)
}

// ============================================================
// 路由:订单管理端(不判权,权限码留后续)
// ============================================================
@server (
	prefix:     /api/v1/admin/orders
	group:      order
	middleware: RequestMeta,Auth
)
service bff {
	@handler ListOrders
	get / (ListOrdersReq) returns (ListOrdersResp)

	@handler GetOrder
	get /:id (OrderIdReq) returns (GetOrderResp)

	@handler ShipOrder
	put /:id/ship (ShipOrderReq) returns (ShipOrderResp)
}

@server (
	prefix:     /api/v1/admin/pay
	group:      payment
	middleware: RequestMeta,Auth
)
service bff {
	@handler ListPayments
	get /list (ListPaymentsReq) returns (ListPaymentsResp)
}

// ============================================================================
// product-service:类目 / 商品 / 库存
// ============================================================================
//
// 响应形状一律取自单体 model/response/{category,product,inventoryLog}.go,
// 不按 proto 推断。本域共 4 类差异:
//
// ① 改名   proto 的 repeated items → HTTP 的 **list**(全部列表接口)
// ② 类型   spec_values / spec_template 在 proto 是 **JSON 文本字符串**,
//          HTTP 是**对象**;min_price / max_price 在 proto 是 int64
// ③ 隐藏   inventory 的流水在 HTTP 里**不返回 order_no / idempotency_key**
//          (proto 有,单体模型没有);category 树的 parent_id 被 json:"-"
// ④ **请求与响应的分页命名不一致**
//          请求:snake_case(page_size)—— 前端 form tag
//          响应:products 与 category 是 **pageSize**(camelCase),
//                inventory 流水是 page_size —— 同一域内都不统一
//
// 另有一处命名陷阱:SkuInventoryResp 上**同时**有 stock 与 total_stock,
// 后者是该 SKU 的"总库存",与 spu 列表响应里的聚合 total_stock **同名不同义**。
// ============================================================
// 类目
// ============================================================
type (
	// Category 对应单体 GetCategoryResp(逐字段一致)
	Category {
		CategoryId    int64  `json:"category_id"`
		ParentId      int64  `json:"parent_id"`
		CategoryName  string `json:"category_name"`
		CategoryLevel int64  `json:"category_level"`
		CategoryPath  string `json:"category_path"`
		SortOrder     int64  `json:"sort_order"`
		IconUrl       string `json:"icon_url"`
		IsLeaf        bool   `json:"is_leaf"`
		IsVisible     bool   `json:"is_visible"`
		Status        string `json:"status"`
	}
	// CreateCategoryReq 前端 CreateCategoryData 的形状
	CreateCategoryReq {
		ParentId     int64  `json:"parent_id"`
		CategoryName string `json:"category_name"`
		SortOrder    int64  `json:"sort_order,optional"`
		IconUrl      string `json:"icon_url,optional"`
		IsVisible    bool   `json:"is_visible,optional"`
	}
	// CreateCategoryResp 对应单体 CreateCategoryResp(与 proto 一致)
	CreateCategoryResp {
		CategoryId   int64  `json:"category_id"`
		CategoryPath string `json:"category_path"`
	}
	// CategoryIdReq 路径参数 :id
	CategoryIdReq {
		Id int64 `path:"id"`
	}
	// CategoryListItem 对应单体 GetListCategoryResp
	CategoryListItem {
		CategoryId    int64  `json:"category_id"`
		ParentId      int64  `json:"parent_id"`
		CategoryName  string `json:"category_name"`
		CategoryLevel int64  `json:"category_level"`
		SortOrder     int64  `json:"sort_order"`
		IsLeaf        bool   `json:"is_leaf"`
		IsVisible     bool   `json:"is_visible"`
		Status        string `json:"status"`
	}
	// CategoryTreeItem 对应单体 GetTreeCategoryResp
	//
	// **没有 parent_id** —— 单体在它上面标了 json:"-"(树里父节点由层级
	// 隐含,不必重复)。照 proto 的 CategoryTreeNode 写也正好没有,两者一致。
	CategoryTreeItem {
		CategoryId    int64              `json:"category_id"`
		CategoryName  string             `json:"category_name"`
		CategoryLevel int64              `json:"category_level"`
		IsVisible     bool               `json:"is_visible"`
		Status        string             `json:"status"`
		Children      []CategoryTreeItem `json:"children"`
	}
	// CategoryTreeReq 查询参数是 **snake_case**(前端 CategoryTreeParams)
	CategoryTreeReq {
		Level           int64 `form:"level,optional"`
		IncludeDisabled bool  `form:"include_disabled,optional"`
	}
	// CategoryChildrenReq 同样 snake_case
	CategoryChildrenReq {
		Id              int64 `path:"id"`
		IncludeDisabled bool  `form:"include_disabled,optional"`
	}
	// CategoryListReq 请求参数 camelCase(**注意与响应一致、与其它域相反**):
	// 单体用 c.DefaultQuery("pageSize", "10"),前端 GetCategoryListParams 也是 pageSize。
	CategoryListReq {
		Page     int `form:"page,optional"`
		PageSize int `form:"pageSize,optional"`
	}
	// CategoryListResp 对应单体 gin.H{list,total,page,pageSize}
	//
	// **键名是 pageSize(camelCase)** —— 与 products 同,与 orders/coupons 的
	// page_size 相反。照 proto 写 total/items 会让前端拿到 undefined。
	CategoryListResp {
		List     []CategoryListItem `json:"list"`
		Total    int64              `json:"total"`
		Page     int                `json:"page"`
		PageSize int                `json:"pageSize"`
	}
	// UpdateCategoryReq 前端 UpdateCategoryData 的形状
	//
	// **不是整体替换**:服务端把字段拼成 updates_json,用 mapstructure 按
	// json tag 解码到实体。故任何字段都能改,包括 parent_id —— 服务端会
	// 重推 category_path 并**同步改写所有后代的 path**。
	//
	// ============================================================
	// **所有字段都必须是指针** —— 否则局部更新无法表达"没传"
	// ============================================================
	//
	// 局部更新的语义是"传了才改",而 updates_json 是**合并**语义:放进
	// JSON 的键才会被改。所以 BFF 必须能区分"这个字段前端没传"与
	// "前端传了零值":
	//
	// 非指针 bool:is_visible=false 与"没传"都是 false
	//   → 要么永远无法隐藏类目(不传 false),要么每次 PUT 都必须
	//     带上 is_visible 当前值(传 false 才生效)
	// 非指针 int64:parent_id=0 与"没传"都是 0
	//   → **"把类目移回根层级"这个操作根本无法表达**
	//
	// 指针能精确表达 presence:nil = 没传,非 nil = 传了(哪怕值是零值)。
	//
	// **单体为什么没这个问题**:它把 body 绑成 map[string]interface{} 后
	// 整体转发(category_handler.go:232),map 天然保留"键是否出现"。
	// goctl 生成物做不到,故用指针补回来。
	//
	// menu 域的 is_visible/is_cache、dept 的 leader_id/sort_order、role 的
	// is_default 都是同样的先例。
	UpdateCategoryReq {
		Id           int64   `path:"id"`
		CategoryName *string `json:"category_name,optional"`
		SortOrder    *int64  `json:"sort_order,optional"`
		IconUrl      *string `json:"icon_url,optional"`
		IsVisible    *bool   `json:"is_visible,optional"`
		Status       *string `json:"status,optional"`
		ParentId     *int64  `json:"parent_id,optional"`
	}
)

// ============================================================
// 商品
// ============================================================
type (
	// ProductImage 对应单体 ImageList
	ProductImage {
		ImageId   int64  `json:"image_id"`
		ImageUrl  string `json:"image_url"`
		SortOrder int64  `json:"sort_order"`
		IsMain    bool   `json:"is_main"`
	}
	// AdminSku 对应单体 SkuList(管理端,含 cost_price / lock_stock)
	AdminSku {
		SkuId      int64             `json:"sku_id"`
		SpuId      int64             `json:"spu_id"`
		SkuName    string            `json:"sku_name"`
		SpecValues map[string]string `json:"spec_values"`
		Price      float64           `json:"price"`
		CostPrice  float64           `json:"cost_price"`
		Stock      int64             `json:"stock"`
		LockStock  int64             `json:"lock_stock"`
		SoldCount  int64             `json:"sold_count"`
		SkuCode    string            `json:"sku_code"`
		SkuImage   string            `json:"sku_image"`
		SkuStatus  string            `json:"sku_status"`
	}
	// UserSku 对应单体 UserSkuList(用户端**不含** cost_price / lock_stock)
	UserSku {
		SkuId      int64       `json:"sku_id"`
		SpuId      int64       `json:"spu_id"`
		SkuName    string      `json:"sku_name"`
		SpecValues interface{} `json:"spec_values"`
		Price      float64     `json:"price"`
		Stock      int64       `json:"stock"`
		SoldCount  int64       `json:"sold_count"`
		SkuCode    string      `json:"sku_code"`
		SkuImage   string      `json:"sku_image"`
		SkuStatus  string      `json:"sku_status"`
	}
	// AdminSpuListItem 对应单体 SpuList
	//
	// min_price / max_price 是 **int64** —— proto 注释写明"DB 侧按整数分位
	// 返回"。前端也是 number,故不转换。
	AdminSpuListItem {
		SpuId        int64  `json:"spu_id"`
		SpuName      string `json:"spu_name"`
		CategoryId   int64  `json:"category_id"`
		CategoryName string `json:"category_name"`
		Brand        string `json:"brand"`
		MainImage    string `json:"main_image"`
		SpuStatus    string `json:"spu_status"`
		Priority     int64  `json:"priority"`
		CreatedAt    string `json:"created_at"`
		UpdatedAt    string `json:"updated_at"`
		MinPrice     int64  `json:"min_price"`
		MaxPrice     int64  `json:"max_price"`
		TotalStock   int64  `json:"total_stock"`
		TotalSold    int64  `json:"total_sold"`
	}
	// UserSpuListItem 对应单体 UserSpuList(字段比管理端少)
	UserSpuListItem {
		SpuId        int64  `json:"spu_id"`
		SpuName      string `json:"spu_name"`
		CategoryName string `json:"category_name"`
		Brand        string `json:"brand"`
		MainImage    string `json:"main_image"`
		MinPrice     int64  `json:"min_price"`
		MaxPrice     int64  `json:"max_price"`
		TotalSold    int64  `json:"total_sold"`
		Stock        int64  `json:"stock"`
	}
	// AdminProductListReq 查询参数 **snake_case**(单体 SpuQueryReq 的 form tag)
	AdminProductListReq {
		Page       int    `form:"page,optional"`
		PageSize   int    `form:"page_size,optional"`
		SpuName    string `form:"spu_name,optional"`
		CategoryId int64  `form:"category_id,optional"`
		SpuStatus  string `form:"spu_status,optional"`
		Brand      string `form:"brand,optional"`
		Sort       string `form:"sort,optional"`
	}
	// AdminProductListResp 对应单体 GetProductListResp
	//
	// **请求 snake_case、响应 camelCase pageSize** —— 同一条接口两侧不一致,
	// 这是单体遗留(请求走 form tag,响应走 json tag 手写)。
	AdminProductListResp {
		List     []AdminSpuListItem `json:"list"`
		Total    int64              `json:"total"`
		Page     int                `json:"page"`
		PageSize int                `json:"pageSize"`
	}
	// UserProductListReq 用户端同样 snake_case
	//
	// **没有 spu_status**(管理端的 AdminProductListReq 有)—— proto 的
	// UserGetProductListReq 无此字段,且服务端**硬编码只看已上架**
	// (客户端传 withdrawn 想偷看下架商品不会被接受)。留着它容易让人
	// 以为能筛状态,故由 .api 直接不提供。
	UserProductListReq {
		Page       int    `form:"page,optional"`
		PageSize   int    `form:"page_size,optional"`
		SpuName    string `form:"spu_name,optional"`
		CategoryId int64  `form:"category_id,optional"`
		Brand      string `form:"brand,optional"`
		Sort       string `form:"sort,optional"`
	}
	// UserProductListResp 对应单体 UserGetProductListResp(同样 pageSize)
	UserProductListResp {
		List     []UserSpuListItem `json:"list"`
		Total    int64             `json:"total"`
		Page     int               `json:"page"`
		PageSize int               `json:"pageSize"`
	}
	// ProductIdReq 路径参数 :id(商品用 spu_id)
	ProductIdReq {
		Id int64 `path:"id"`
	}
	// SpecTemplateItem 规格模板的一项,如 {"name":"颜色","values":["红","蓝"]}。
	//
	// ============================================================
	// 为什么必须声明成结构体切片,而不是 interface{}
	// ============================================================
	//
	// 前端发的是**数组**(types/product.ts 的 `SpecTemplateItem[]`),而
	// go-zero 的 mapping 反序列化器**没有 `reflect.Interface` 分支** ——
	// 给 interface{} 字段喂一个数组会直接报:
	//
	// 请求参数解析失败: type mismatch for field "spec_template"  → 400
	//
	// 这是实测到的报错,不是推测。
	//
	// 同一批类型里凡 wire 上是数组的字段(`[]CategoryTreeItem`、
	// `[]AdminSku`、`[]ProductImage` …)都是显式切片类型 ——
	// spec_template 原本被写成 interface{} 是本 .api 的**不一致**,现已纠正。
	//
	// 注意 `spec_values` 是**另一种情况**:它是"规格名 → 规格值"的**对象**
	// (如 {"颜色":"红"}),wire 上是 map,故仍可用 interface{} 承接。
	SpecTemplateItem {
		Name   string   `json:"name"`
		Values []string `json:"values"`
	}
	// AdminProductResp 对应单体 GetProductResp
	//
	// SpecTemplate 在 proto 里是 JSON 文本,在 HTTP 里是**数组**
	// (见 SpecTemplateItem)。管理端 sku_list 用 AdminSku。
	AdminProductResp {
		SpuId        int64              `json:"spu_id"`
		SpuName      string             `json:"spu_name"`
		CategoryId   int64              `json:"category_id"`
		CategoryName string             `json:"category_name"`
		Brand        string             `json:"brand"`
		Description  string             `json:"description"`
		MainImage    string             `json:"main_image"`
		SpecTemplate []SpecTemplateItem `json:"spec_template"`
		SpuStatus    string             `json:"spu_status"`
		Priority     int64              `json:"priority"`
		SkuList      []AdminSku         `json:"sku_list"`
		ImageList    []ProductImage     `json:"image_list"`
		CreatedAt    string             `json:"created_at"`
		UpdatedAt    string             `json:"updated_at"`
	}
	// UserProductResp 对应单体 UserGetProductResp(用户端 sku_list 不含成本价)
	UserProductResp {
		SpuId        int64              `json:"spu_id"`
		SpuName      string             `json:"spu_name"`
		CategoryId   int64              `json:"category_id"`
		CategoryName string             `json:"category_name"`
		Brand        string             `json:"brand"`
		Description  string             `json:"description"`
		MainImage    string             `json:"main_image"`
		SpecTemplate []SpecTemplateItem `json:"spec_template"`
		SpuStatus    string             `json:"spu_status"`
		Priority     int64              `json:"priority"`
		SkuList      []UserSku          `json:"sku_list"`
		ImageList    []ProductImage     `json:"image_list"`
		CreatedAt    string             `json:"created_at"`
		UpdatedAt    string             `json:"updated_at"`
	}
	// CreateSkuItem 建品时的 SKU(无 sku_id —— 由服务端生成)
	//
	// SpecValues 用 map[string]string 而不是 interface{}:**请求方向不能用
	// interface{}**(go-zero 的映射器对 reflect.Interface 必然报
	// type mismatch,见 SpecTemplateItem 的注释)。前端类型是
	// Record<string, string>,与此一致。
	CreateSkuItem {
		SkuName    string            `json:"sku_name"`
		SpecValues map[string]string `json:"spec_values"`
		Price      float64           `json:"price"`
		CostPrice  float64           `json:"cost_price,optional"`
		Stock      int64             `json:"stock"`
		SkuCode    string            `json:"sku_code,optional"`
		SkuImage   string            `json:"sku_image,optional"`
		// SkuStatus 前端会传 'active' / 'inactive'。
		//
		// **必须声明它**:go-zero 对未声明的 JSON 字段是**静默丢弃**,
		// 而 product_db 有 CHECK 约束 ck_sku_status IN ('active','inactive')
		// —— 丢成空串会让 INSERT 直接失败(整个建品接口 503)。
		// GORM 也不会用列默认值兜(模型没有 default 标签,零值会被显式写进 INSERT)。
		SkuStatus string `json:"sku_status,optional"`
	}
	// CreateProductReq 前端 CreateProductReq 的形状(整体建品:SPU + SKU + 图片)
	CreateProductReq {
		SpuName      string             `json:"spu_name"`
		CategoryId   int64              `json:"category_id"`
		Brand        string             `json:"brand,optional"`
		Description  string             `json:"description,optional"`
		MainImage    string             `json:"main_image,optional"`
		SpecTemplate []SpecTemplateItem `json:"spec_template,optional"`
		Priority     int64              `json:"priority,optional"`
		SkuList      []CreateSkuItem    `json:"sku_list"`
		ImageList    []ProductImage     `json:"image_list,optional"`
		// SpuStatus 前端固定传 "published"(创建即上架)。
		//
		// **必须声明**(与 SkuStatus 同理:不声明就被丢弃,撞
		// ck_spu_status CHECK 约束)。
		//
		// **但 BFF 不用这个值**:product 的 logic 会**强制改成 draft**
		// (见 createproductlogic.go)。理由:上架路径(product-service 的
		// Publish)会做库存/价格校验,而"创建即 published"绕过了它 ——
		// 单体正是这样,结果是能建出没库存没价格的已上架商品。
		// 强制草稿后运营必须点一次上架,那次会过校验。
		//
		// 代价是**前端可见行为变了**:新建商品以草稿出现。
		SpuStatus string `json:"spu_status,optional"`
	}
	// CreateProductResp 只回 spu_id(proto 的 CreateProductResp 就是两字段)
	CreateProductResp {
		SpuId int64 `json:"spu_id"`
	}
	// UpdateProductReq 局部更新(前端 UpdateProductReq)
	//
	// 与类目同理:服务端拼 updates_json 逐字段合并,故全 optional。
	UpdateProductReq {
		Id          int64  `path:"id"`
		SpuName     string `json:"spu_name,optional"`
		CategoryId  int64  `json:"category_id,optional"`
		Brand       string `json:"brand,optional"`
		Description string `json:"description,optional"`
		MainImage   string `json:"main_image,optional"`
		SpuStatus   string `json:"spu_status,optional"`
		Priority    int64  `json:"priority,optional"`
	}
	// UpdateProductFullReq 整体更新(前端 UpdateProductFullReq)
	//
	// **SKU 对比规则**(单体 requset 注释):带 sku_id 的更新、不带的插入、
	// DB 里有而请求里没有的**删除**。故它是"以请求为准的全量覆盖"。
	UpdateProductFullReq {
		Id           int64              `path:"id"`
		SpuName      string             `json:"spu_name"`
		CategoryId   int64              `json:"category_id"`
		Brand        string             `json:"brand,optional"`
		Description  string             `json:"description,optional"`
		MainImage    string             `json:"main_image,optional"`
		SpecTemplate []SpecTemplateItem `json:"spec_template,optional"`
		Priority     int64              `json:"priority,optional"`
		SkuList      []AdminSku         `json:"sku_list,optional"`
		ImageList    []ProductImage     `json:"image_list,optional"`
		// DeleteImageIds 要删除的图片 id 列表。
		//
		// **必须声明**:前端编辑页删掉一张图时靠它下发,服务端删图**只认
		// 这个字段**。不声明它,删图操作会在 go-zero 解析时被静默丢弃 ——
		// 表现为"点了删除、保存成功、图片还在"。
		//
		// **注意图片与 SKU 的删除规则不对称**:
		// SKU  : 请求里没带的会被**软删**(以请求为准的全量覆盖)
		// 图片 : 只有出现在 delete_image_ids 里的才删(没带就不动)
		// 所以"提交了不完整的 sku_list"会静默删 SKU,而图片不会。
		DeleteImageIds []int64 `json:"delete_image_ids,optional"`
	}
)

// ============================================================
// 库存
// ============================================================
type (
	// SkuInventory 对应单体 SkuInventoryResp
	//
	// **注意 stock 与 total_stock 并存**:stock 是可用库存,total_stock 是
	// 该 SKU 的总库存。而同域的 SkuInventoryListResp 里也有一个 total_stock
	// 表示**所有 SKU 之和** —— 同名不同义,读代码时极易混。
	SkuInventory {
		SkuId      int64       `json:"sku_id"`
		SkuName    string      `json:"sku_name"`
		SpuId      int64       `json:"spu_id"`
		SpuName    string      `json:"spu_name"`
		SpecValues interface{} `json:"spec_values"`
		Stock      int64       `json:"stock"`
		LockStock  int64       `json:"lock_stock"`
		TotalStock int64       `json:"total_stock"`
		SoldCount  int64       `json:"sold_count"`
		SkuStatus  string      `json:"sku_status"`
	}
	// SkuStockReq 路径参数 :id(单个 SKU 库存)
	SkuStockReq {
		Id int64 `path:"id"`
	}
	// SkuStockResp 单个 SKU 库存(裸对象,不是 list)。
	//
	// **刻意展开而不是 `type SkuStockResp = SkuInventory`** —— goctl 不支持
	// 类型别名(实测报 syntax error: expected <struct> expr)。
	SkuStockResp {
		SkuId      int64       `json:"sku_id"`
		SkuName    string      `json:"sku_name"`
		SpuId      int64       `json:"spu_id"`
		SpuName    string      `json:"spu_name"`
		SpecValues interface{} `json:"spec_values"`
		Stock      int64       `json:"stock"`
		LockStock  int64       `json:"lock_stock"`
		TotalStock int64       `json:"total_stock"`
		SoldCount  int64       `json:"sold_count"`
		SkuStatus  string      `json:"sku_status"`
	}
	// SpuStockReq 路径参数 :id(某个 SPU 下全部 SKU)
	SpuStockReq {
		Id int64 `path:"id"`
	}
	// SpuStockResp 对应单体 SkuInventoryListResp
	SpuStockResp {
		List       []SkuInventory `json:"list"`
		TotalStock int64          `json:"total_stock"`
		TotalLock  int64          `json:"total_lock"`
		TotalSold  int64          `json:"total_sold"`
	}
	// AdjustStockReq 前端 InventoryAdjustReq 的形状
	//
	// **user_id 不在请求里** —— 操作人取自 JWT(落库存流水的 create_by)。
	// remark 是必填:服务端空则拒绝(与单体口径一致)。
	AdjustStockReq {
		SkuId     int64  `json:"sku_id"`
		ChangeQty int64  `json:"change_qty"`
		Remark    string `json:"remark"`
	}
	// AdjustStockResp 对应单体 InventoryAdjustResp
	//
	// 幂等命中(同一 sku+change_qty+remark 已调整过)时前后值相等。
	AdjustStockResp {
		BeforeStock int64 `json:"before_stock"`
		AfterStock  int64 `json:"after_stock"`
	}
	// StockLogItem 对应单体 InventoryLogList(内嵌 SysProductStockLog + 两个名称)
	//
	// **没有 order_no / idempotency_key** —— proto 的 StockLog 有,而单体
	// 返回给前端的模型里没有。故 BFF 也不返回(保持前端契约不变)。
	StockLogItem {
		LogId       int64  `json:"log_id"`
		SkuId       int64  `json:"sku_id"`
		SkuName     string `json:"sku_name"`
		SpuName     string `json:"spu_name"`
		ChangeType  string `json:"change_type"`
		ChangeQty   int64  `json:"change_qty"`
		BeforeStock int64  `json:"before_stock"`
		AfterStock  int64  `json:"after_stock"`
		BeforeLock  int64  `json:"before_lock"`
		AfterLock   int64  `json:"after_lock"`
		OrderId     int64  `json:"order_id"`
		Remark      string `json:"remark"`
		CreatedAt   string `json:"created_at"`
		CreateBy    int64  `json:"create_by"`
	}
	// StockLogReq 查询参数 snake_case(前端 InventoryLogQuery)
	//
	// **sku_id / spu_id 是可选数字**:proto 用 Int64Value 包装,不传即不过滤。
	// 这里用 optional,logic 侧按"零值即不过滤"处理 —— 注意这**区分不了**
	// "不传"与"传 0",但 id 为 0 本就不是合法业务值,故无实际影响。
	StockLogReq {
		Page       int    `form:"page,optional"`
		PageSize   int    `form:"page_size,optional"`
		SkuId      int64  `form:"sku_id,optional"`
		SpuId      int64  `form:"spu_id,optional"`
		ChangeType string `form:"change_type,optional"`
		StartTime  string `form:"start_time,optional"`
		EndTime    string `form:"end_time,optional"`
	}
	// StockLogResp 对应单体 InventoryLogResp(**注意这里是 page_size**)
	StockLogResp {
		List     []StockLogItem `json:"list"`
		Total    int64          `json:"total"`
		Page     int            `json:"page"`
		PageSize int            `json:"page_size"`
	}
	// WarnStockReq 查询参数(前端 InventoryWarnQuery)
	//
	// threshold <= 0 时服务端取默认 10;spu_status 空时服务端取默认 published。
	WarnStockReq {
		Threshold int64  `form:"threshold,optional"`
		SpuStatus string `form:"spu_status,optional"`
	}
	// WarnStockItem 对应单体 InventoryWarnResp
	WarnStockItem {
		SkuId     int64  `json:"sku_id"`
		SpuName   string `json:"spu_name"`
		SkuName   string `json:"sku_name"`
		Stock     int64  `json:"stock"`
		LockStock int64  `json:"lock_stock"`
		SoldCount int64  `json:"sold_count"`
		SkuStatus string `json:"sku_status"`
	}
)

// ============================================================
// 营销:优惠券
// ============================================================
type (
	// CouponTemplate 对应单体 UserCouponTemplate 之外的 GetCouponList
	//
	// **不返回 is_deleted / updated_at**(proto 有,单体模型没有),
	// start_time / end_time 也不返回 —— 前端类型里确实没有它们。
	CouponTemplateItem {
		TemplateId      int64   `json:"template_id"`
		CouponName      string  `json:"coupon_name"`
		CouponType      string  `json:"coupon_type"`
		ThresholdAmount float64 `json:"threshold_amount"`
		DiscountAmount  float64 `json:"discount_amount"`
		TotalCount      int64   `json:"total_count"`
		ReceivedCount   int64   `json:"received_count"`
		PerUserLimit    int64   `json:"per_user_limit"`
		UsableDays      int64   `json:"usable_days"`
		StartTime       string  `json:"start_time"`
		EndTime         string  `json:"end_time"`
		// Status 由服务端按当前时间推导(not_started / ongoing / ended)。
		// 单体在它上面标 gorm:"-" —— 不是数据库列。
		Status string `json:"status"`
	}
	// AdminCouponListReq 查询参数 snake_case(单体 request 的 form tag)
	AdminCouponListReq {
		Page       int    `form:"page,optional"`
		PageSize   int    `form:"page_size,optional"`
		CouponName string `form:"coupon_name,optional"`
		CouponType string `form:"coupon_type,optional"`
	}
	// AdminCouponListResp 对应单体 GetCouponListResp
	//
	// **这里是 page_size(snake_case)** —— 与 products/category 的 pageSize 相反。
	AdminCouponListResp {
		List     []CouponTemplateItem `json:"list"`
		Page     int                  `json:"page"`
		PageSize int                  `json:"page_size"`
		Total    int64                `json:"total"`
	}
	// CreateCouponTemplateReq 前端 CreateCouponReq 的形状
	CreateCouponTemplateReq {
		CouponName      string  `json:"coupon_name"`
		CouponType      string  `json:"coupon_type"`
		ThresholdAmount float64 `json:"threshold_amount"`
		DiscountAmount  float64 `json:"discount_amount"`
		TotalCount      int64   `json:"total_count"`
		PerUserLimit    int64   `json:"per_user_limit"`
		UsableDays      int64   `json:"usable_days,optional"`
		StartTime       string  `json:"start_time,optional"`
		EndTime         string  `json:"end_time,optional"`
	}
	// CreateCouponTemplateResp 对应单体 CreateCouponResp —— **只有 template_id**
	CreateCouponTemplateResp {
		TemplateId int64 `json:"template_id"`
	}
	// CouponTemplateIdReq 路径参数 :id(模板)
	CouponTemplateIdReq {
		Id int64 `path:"id"`
	}
	// UserCouponTemplateItem 对应单体 UserCouponTemplate(可领取的模板)
	//
	// 比管理端模板多了 held_count / remaining_count(该用户视角)。
	UserCouponTemplateItem {
		TemplateId      int64   `json:"template_id"`
		CouponName      string  `json:"coupon_name"`
		CouponType      string  `json:"coupon_type"`
		ThresholdAmount float64 `json:"threshold_amount"`
		DiscountAmount  float64 `json:"discount_amount"`
		PerUserLimit    int64   `json:"per_user_limit"`
		HeldCount       int64   `json:"held_count"`
		RemainingCount  int64   `json:"remaining_count"`
		UsableDays      int64   `json:"usable_days"`
		StartTime       string  `json:"start_time"`
		EndTime         string  `json:"end_time"`
	}
	// UserCouponTemplateListReq 用户端模板列表查询参数
	UserCouponTemplateListReq {
		Page       int    `form:"page,optional"`
		PageSize   int    `form:"page_size,optional"`
		CouponName string `form:"coupon_name,optional"`
		CouponType string `form:"coupon_type,optional"`
	}
	// UserCouponTemplateListResp 对应单体 UserCouponTemplateListResp
	UserCouponTemplateListResp {
		List     []UserCouponTemplateItem `json:"list"`
		Page     int                      `json:"page"`
		PageSize int                      `json:"page_size"`
		Total    int64                    `json:"total"`
	}
	// UserCouponItem 对应单体 UserGetCouponList
	//
	// **不返回 user_id**(单体标 json:"-")、不返回 template_id。
	UserCouponItem {
		UserCouponId    int64   `json:"user_coupon_id"`
		CouponName      string  `json:"coupon_name"`
		CouponType      string  `json:"coupon_type"`
		ThresholdAmount float64 `json:"threshold_amount"`
		DiscountAmount  float64 `json:"discount_amount"`
		Status          string  `json:"status"`
		ExpireAt        string  `json:"expire_at"`
		OrderNo         string  `json:"order_no"`
		UsedAt          string  `json:"used_at"`
	}
	// UserCouponListReq 我的券列表查询参数
	UserCouponListReq {
		Page     int    `form:"page,optional"`
		PageSize int    `form:"page_size,optional"`
		Status   string `form:"status,optional"`
	}
	// UserCouponListResp 对应单体 UserGetCouponListResp
	UserCouponListResp {
		List     []UserCouponItem `json:"list"`
		Page     int              `json:"page"`
		PageSize int              `json:"page_size"`
		Total    int64            `json:"total"`
	}
	// AvailableCouponReq 下单可用券查询(可带订单金额试算)
	AvailableCouponReq {
		OrderAmount float64 `form:"order_amount,optional"`
	}
	// AvailableCouponItem 对应单体 GetAvailableCouponList
	//
	// **PayAfter 是"用这张券之后的应付金额"** —— 服务端算好给前端展示,
	// 前端不必再算一遍(算错会与下单金额不一致)。
	AvailableCouponItem {
		UserCouponId    int64   `json:"user_coupon_id"`
		CouponName      string  `json:"coupon_name"`
		CouponType      string  `json:"coupon_type"`
		ThresholdAmount float64 `json:"threshold_amount"`
		DiscountAmount  float64 `json:"discount_amount"`
		PayAfter        float64 `json:"pay_after"`
	}
	// AvailableCouponResp 对应单体 GetAvailableCouponResp —— **只有 list**
	AvailableCouponResp {
		List []AvailableCouponItem `json:"list"`
	}
	// ReceiveCouponReq 路径参数 :id(模板 id)
	ReceiveCouponReq {
		Id int64 `path:"id"`
	}
	// ReceiveCouponResp 对应单体 UserReceiveCouponResp
	//
	// **字段名是 expire_time 而不是 expire_at** —— 单体在这里用了另一个名字,
	// 而 UserGetCouponList 里叫 expire_at。同名概念两个名字,别统一。
	ReceiveCouponResp {
		UserCouponId int64  `json:"user_coupon_id"`
		ExpireTime   string `json:"expire_time"`
	}
)

// ============================================================
// 路由:类目管理端
// ============================================================
@server (
	prefix:     /api/v1/admin/category
	group:      category
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreateCategory
	post / (CreateCategoryReq) returns (CreateCategoryResp)

	@handler ListCategories
	get / (CategoryListReq) returns (CategoryListResp)

	// 静态段 /tree 必须在 /:id 之前声明语义上更清晰;go-zero 按静态优先
	@handler GetCategoryTree
	get /tree (CategoryTreeReq) returns ([]CategoryTreeItem)

	@handler GetCategoryChildren
	get /children/:id (CategoryChildrenReq) returns ([]CategoryListItem)

	@handler GetCategory
	get /:id (CategoryIdReq) returns (Category)

	@handler UpdateCategory
	put /:id (UpdateCategoryReq) returns (Category)

	@handler DeleteCategory
	delete /:id (CategoryIdReq) returns (Empty)
}

// ============================================================
// 路由:商品管理端
// ============================================================
@server (
	prefix:     /api/v1/admin/products
	group:      product
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreateProduct
	post / (CreateProductReq) returns (CreateProductResp)

	@handler ListProducts
	get / (AdminProductListReq) returns (AdminProductListResp)

	@handler GetProduct
	get /:id (ProductIdReq) returns (AdminProductResp)

	@handler UpdateProduct
	put /:id (UpdateProductReq) returns (Empty)

	// 整体更新:以请求为准覆盖 SKU 列表(不带的会删)
	@handler UpdateProductFull
	put /:id/full (UpdateProductFullReq) returns (Empty)

	@handler PublishProduct
	post /:id/publish (ProductIdReq) returns (Empty)

	@handler WithdrawProduct
	post /:id/withdraw (ProductIdReq) returns (Empty)

	@handler DeleteProduct
	delete /:id (ProductIdReq) returns (Empty)
}

// ============================================================
// 路由:商品用户端(不判权 —— 前台下单浏览用)
// ============================================================
@server (
	prefix:     /api/v1/products
	group:      product
	middleware: RequestMeta,Auth
)
service bff {
	@handler UserListProducts
	get / (UserProductListReq) returns (UserProductListResp)

	@handler UserGetProduct
	get /:id (ProductIdReq) returns (UserProductResp)
}

// ============================================================
// 路由:库存管理端
// ============================================================
@server (
	prefix:     /api/v1/admin/inventory
	group:      inventory
	middleware: RequestMeta,Auth
)
service bff {
	// 单个 SKU 库存(裸对象,不是 list)
	@handler GetSkuStock
	get /sku/:id (SkuStockReq) returns (SkuStockResp)

	// 某个 SPU 下全部 SKU 库存(带聚合值)
	@handler ListSkuStockBySpu
	get /spu/:id (SpuStockReq) returns (SpuStockResp)

	@handler AdjustStock
	post /adjust (AdjustStockReq) returns (AdjustStockResp)

	@handler ListStockLogs
	get /log (StockLogReq) returns (StockLogResp)

	@handler ListWarnStock
	get /warning (WarnStockReq) returns ([]WarnStockItem)
}

// ============================================================
// 路由:优惠券
// ============================================================
@server (
	prefix:     /api/v1/admin/coupons
	group:      coupon
	middleware: RequestMeta,Auth
)
service bff {
	@handler CreateCouponTemplate
	post / (CreateCouponTemplateReq) returns (CreateCouponTemplateResp)

	@handler ListCouponTemplates
	get / (AdminCouponListReq) returns (AdminCouponListResp)
}

// 用户端券接口:都要登录(券属于个人),但**不判权**(没有权限点)。
//
// 领券挂 PublicRateLimit —— 它是写操作且可被刷(单体也在这一条上挂了
// PerIPRateLimit)。组里其余是读,故用**另一个 @server 块**单独挂限流,
// 避免给读接口也加限流(那会让券列表页在快速切换时被拒)。
@server (
	prefix:     /api/v1/coupons
	group:      coupon
	middleware: RequestMeta,Auth
)
service bff {
	@handler ListUserCoupons
	get / (UserCouponListReq) returns (UserCouponListResp)

	@handler ListCouponTemplatesForUser
	get /templates (UserCouponTemplateListReq) returns (UserCouponTemplateListResp)

	@handler ListAvailableCoupons
	get /available (AvailableCouponReq) returns (AvailableCouponResp)
}

@server (
	prefix:     /api/v1/coupons
	group:      coupon
	middleware: RequestMeta,Auth,PublicRateLimit
)
service bff {
	@handler ReceiveCoupon
	post /receive/:id (ReceiveCouponReq) returns (ReceiveCouponResp)
}

