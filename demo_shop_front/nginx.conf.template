# 反代目标:单个 BFF。
#
# 单体时代这里是 upstream backend_cluster { backend-1, backend-2 } —— 两个
# 单体实例轮询。拆成微服务后,负载均衡的职责移到 BFF 之后(客户端经 etcd
# 做服务发现),nginx 这一层只需要一个目标,故不再需要 upstream 块。
#
# 目标名 bff 由环境变量 BACKEND_UPSTREAM 注入(见 docker-compose.yml 的
# frontend 服务)。envsubst 只替换真实存在的环境变量,故这里的字面量安全。

server {
    listen 80;

    # 静态资源带 hash,长缓存
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # API 反代:不做 rewrite,后端路由自带 /api/v1 前缀
    location /api/v1/ {
        proxy_pass http://${BACKEND_UPSTREAM}:9003;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        # keepalive 需要 HTTP/1.1 且清空 Connection(否则每个请求新建连接,
        # LB 压测会把 TIME_WAIT 算进服务端开销)
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # ============================================================
    # 上传文件**不再**由后端静态服务提供
    # ============================================================
    #
    # 单体时代有 `r.Static("/uploads", "./uploads")`,前端上传后拿到
    # /uploads/xxx.png 这种同源相对路径,于是这里需要一条 /uploads/ 反代。
    #
    # 现在文件落在对象存储(MinIO),BFF 返回的 file_url 是**绝对 URL**
    # (http://localhost:9000/demo-shop/<key>),浏览器直接去 MinIO 取,
    # 不经过 nginx。所以这条 location 已无意义 —— 保留它只会让人误以为
    # 文件仍然走同源路径。

    # SPA 路由回退:/order/123 刷新时 nginx 找不到文件,回退到 index.html 交给前端路由
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
